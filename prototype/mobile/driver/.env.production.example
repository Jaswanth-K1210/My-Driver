# Production values for the driver app. Copy to .env.production for a local
# build, or set the same names as EAS environment variables for cloud builds
# (eas env:create --environment production ...). Nothing here is secret:
# EXPO_PUBLIC_* values are compiled into the app and can be read by anyone.

# The API. Must be HTTPS: the same host serves the WebSocket as wss://.
EXPO_PUBLIC_API_URL=https://api.mydriver.in

# Google OAuth client ID for this platform (Android or iOS), from Google Cloud
# Console > Credentials. Must also be listed in the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── Build-time only (read by app.config.js, not shipped as EXPO_PUBLIC) ────
# Maps SDK for Android key, restricted to the app's package name and signing
# certificate. Without it the app shows the address and a Navigate button
# instead of the map.
GOOGLE_MAPS_API_KEY_ANDROID=

# Path to the Firebase config for Android. On EAS upload it as a file secret:
#   eas env:create --environment production --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json
# The Firebase project must list every package name that is built:
#   com.mydriver.driver, com.mydriver.driver.preview, com.mydriver.driver.dev
# GOOGLE_SERVICES_JSON=./google-services.json
