# Leave blank to auto-detect: the app derives the backend URL from the Expo dev
# server's host, so it works on a real device with no hand-edited IP.
# Set it explicitly for a tunnel or a staging backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google OAuth client ID for THIS platform (iOS or Android), from
# Google Cloud Console > Credentials. The same ID must also be listed in the
# backend's GOOGLE_CLIENT_IDS. Blank leaves the Google button disabled.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
