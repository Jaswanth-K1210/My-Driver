# Leave blank to auto-detect: the app derives the backend URL from the Expo dev
# server's host, so it works on a real device with no hand-edited IP.
# Set it explicitly for a tunnel or a staging backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google OAuth client ID for THIS platform (iOS or Android), from
# Google Cloud Console > Credentials. The same ID must also be listed in the
# backend's GOOGLE_CLIENT_IDS. Blank leaves the Google button disabled.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Comma-separated Phase 2 features to switch on for this run (see
# src/lib/features.js). Blank keeps the Phase 1 defaults.
# EXPO_PUBLIC_FEATURES=fullTimeContracts

# Sentry observability (docs/testing-plan.md §9). Off when DSN is blank or in Expo Go.
# Set the customer app DSN rate limit to 40 errors/day in Sentry Project Settings > Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=local
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
