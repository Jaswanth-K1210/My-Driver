NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# All application traffic goes through PgBouncer in transaction pooling mode.
DATABASE_URL=postgres://mydriver:mydriver@localhost:6432/mydriver
# Migrations need a session-mode connection, so they bypass PgBouncer.
DATABASE_MIGRATION_URL=postgres://mydriver:mydriver@localhost:5433/mydriver
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6380
REDIS_CLUSTER=false

JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
TOKEN_PEPPER=dev-only-pepper-change-me-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

GOOGLE_CLIENT_IDS=

SMS_PROVIDER=console
PUSH_PROVIDER=console
LIVENESS_PROVIDER=mock
LIVENESS_MOCK_CONFIDENCE=0.97
LIVENESS_MIN_CONFIDENCE=0.8

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mydriver
STORAGE_ACCESS_KEY=mydriver
STORAGE_SECRET_KEY=mydriver123
STORAGE_FORCE_PATH_STYLE=true
