NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# All application traffic goes through PgBouncer in transaction pooling mode.
DATABASE_URL=postgres://mydriver:mydriver@localhost:6432/mydriver
# Migrations need a session-mode connection, so they bypass PgBouncer.
DATABASE_MIGRATION_URL=postgres://mydriver:mydriver@localhost:5433/mydriver
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6380
REDIS_CLUSTER=false

JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
TOKEN_PEPPER=dev-only-pepper-change-me-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Browser origins allowed to call the API (website dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Google OAuth: comma-separated client IDs the backend will accept as the
# id_token audience. You need three - iOS, Android and Web - from
# Google Cloud Console > Credentials. Paste all three here, comma separated.
GOOGLE_CLIENT_IDS=

SMS_PROVIDER=console
PUSH_PROVIDER=console
VOICE_PROVIDER=console

# Where guardian tracking links point (the public website).
PUBLIC_WEB_URL=http://localhost:5173
LIVENESS_PROVIDER=mock
LIVENESS_MOCK_CONFIDENCE=0.97
LIVENESS_MIN_CONFIDENCE=0.8

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mydriver
STORAGE_ACCESS_KEY=mydriver
STORAGE_SECRET_KEY=mydriver123
STORAGE_FORCE_PATH_STYLE=true

# KYC: mock accepts any well-formed PAN and Aadhaar OTP 123456.
KYC_PROVIDER=mock
# CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=

# Payments: none | mock | razorpay. mock serves an Approve/Decline test checkout.
PAYMENTS_PROVIDER=mock
PUBLIC_API_URL=http://localhost:4000
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Host port for Postgres (change if 5433 is taken; keep DATABASE_MIGRATION_URL in step).
MYDRIVER_PG_PORT=5433

# Location search: mock (built-in Hyderabad places) | google (Places API, Text Search).
MAPS_PROVIDER=mock
# GOOGLE_MAPS_API_KEY=
# LOCATION_CACHE_TTL_SECONDS=86400
