# Backend API. Change the port if you run the backend elsewhere.
VITE_API_URL=http://localhost:4000

# Google OAuth Web client ID (from Google Cloud Console > Credentials).
# Leave blank to disable the Google button. The same ID must also appear in the
# backend's GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=

# Sentry (docs/testing-plan.md §9). Empty DSN = off; leave it empty for local dev and CI.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
# VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
