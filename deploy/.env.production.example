# MyDriver production environment. Copy to .env.production and fill in EVERY
# value. The API refuses to start if anything below is left at a development
# default (see productionProblems() in src/config/env.ts).
#
# Generate secrets with:   openssl rand -hex 32
# Use hex (or other URL-safe) passwords: they are embedded in connection URLs.

RELEASE=2026.10.0

# ── Domains (Caddy issues TLS for all three automatically) ────────────────
WEB_DOMAIN=mydriver.in
ADMIN_DOMAIN=admin.mydriver.in
API_DOMAIN=api.mydriver.in
PUBLIC_WEB_URL=https://mydriver.in
PUBLIC_API_URL=https://api.mydriver.in
# ADMIN_WEB_URL is set from ADMIN_DOMAIN by docker-compose.prod.yml.
# CORS must list the website AND the console.
CORS_ORIGINS=https://mydriver.in,https://www.mydriver.in,https://admin.mydriver.in
# Optional: limit the console to these networks (space-separated CIDRs).
# Empty = reachable from anywhere (staff sign-in and roles still apply).
ADMIN_ALLOWED_IPS=

# ── Database and cache (internal to the compose network) ──────────────────
POSTGRES_USER=mydriver
POSTGRES_PASSWORD=
POSTGRES_DB=mydriver
REDIS_PASSWORD=
# Redis memory cap. Raise it with the host: about a quarter of RAM on a
# single-host deploy is plenty.
REDIS_MAXMEMORY=512mb
DATABASE_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=
TOKEN_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma-separated Google OAuth client IDs (iOS, Android, Web). Optional.
GOOGLE_CLIENT_IDS=
# Website build: the Web OAuth client ID. Optional; blank hides the button.
VITE_GOOGLE_CLIENT_ID=
# Website build: later-phase features to switch on, comma separated. Blank =
# phase 1 only. Options: busBooking, caravanBooking, scheduledPickup,
# fullTimeContracts (see prototype/website/src/lib/features.js).
VITE_FEATURES=

# ── Operations ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Required: GET /metrics demands  Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
# Sentry errors and sampled traces, tagged with RELEASE. Empty DSN = off.
# SENTRY_DSN is the backend project; VITE_SENTRY_DSN the website/console
# project (baked into the website build). Environment: staging or production.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── SMS / voice / push ────────────────────────────────────────────────────
SMS_PROVIDER=twilio
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_JSON=
# iPhones (D-1): APNs .p8 key from Apple Developer > Keys, one line with \n escapes.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPICS=com.mydriver.user,com.mydriver.driver
APNS_PRODUCTION=true

# ── Identity checks (Cashfree Verification Suite) ─────────────────────────
KYC_PROVIDER=cashfree
CASHFREE_BASE_URL=https://api.cashfree.com/verification
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
KYC_MIN_NAME_MATCH=80

# ── Payments (Razorpay; test keys work for a staging deploy) ──────────────
PAYMENTS_PROVIDER=razorpay
# true: no hold at booking; the customer pays the final fare after the trip.
# Off until prd.md 3.2 (hold at booking) is changed.
PAY_AFTER_TRIP=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://api.mydriver.in/v1/payments/webhook,
# events payment.authorized and payment.failed.
RAZORPAY_WEBHOOK_SECRET=

# ── Places search (Google Places API, Text Search New) ────────────────────
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Search leans towards this point when the app sends none (D-4: Hyderabad).
PLACE_SEARCH_BIAS=17.3850,78.4867
LOCATION_CACHE_TTL_SECONDS=86400

# ── Object storage (S3 or any S3-compatible store) ────────────────────────
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# ── Face match (no vendor yet; the API warns at boot) ─────────────────────
LIVENESS_PROVIDER=mock
LIVENESS_MIN_CONFIDENCE=0.8
